{
  "name": "geodisk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx src/server/main.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/main.js",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts",
    "calibrate": "tsx src/server/calibrate_cli.ts"
  },
  "dependencies": {
    "@fails-components/webtransport": "^1.6.12",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.12",
    "@google/genai": "^2.4.0",
    "@peculiar/x509": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "reflect-metadata": "^0.2.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
